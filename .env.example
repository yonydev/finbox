# Copy to .env and fill in. NEVER commit .env.
FINBOX_DB_URL=postgres://finbox:finbox@postgres:5432/finbox
FINBOX_BLOB_DIR=/data/receipts
TELEGRAM_BOT_TOKEN=123456:replace-me        # BotFather → /newbot
TELEGRAM_ALLOWED_USER_IDS=                  # empty on first run: send the bot a message, read your id from the logs
OPENAI_API_KEY=sk-replace-me
FINBOX_OPENAI_MODEL=gpt-4o-mini
TZ=America/Mexico_City
# Postgres password (compose default: finbox for local dev; SET A REAL ONE on the Pi)
POSTGRES_PASSWORD=change-me-on-the-pi
